{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert note API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "note",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates new note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.salv.com/api/v1/persons/:personId/notes",
            "params": [
              {
                "name": "personId",
                "value": "",
                "type": "path",
                "description": "ID of person"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates new note"
        }
      ]
    }
  ],
  "bundled": true
}