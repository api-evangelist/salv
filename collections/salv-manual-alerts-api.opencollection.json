{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert manual-alerts API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "manual-alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create manual alert",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.salv.com/api/v1/manual-alerts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new manual alert for a person or transaction."
        },
        {
          "info": {
            "name": "Update manual alert",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{environment}.salv.com/api/v1/manual-alerts/:alertId",
            "params": [
              {
                "name": "alertId",
                "value": "",
                "type": "path",
                "description": "ID of manual alert to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a manual alert including rationale, comment, and optionally status."
        }
      ]
    }
  ],
  "bundled": true
}