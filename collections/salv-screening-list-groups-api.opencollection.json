{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert screening-list-groups API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "screening-list-groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get List Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.salv.com/api/v1/screening-list-groups"
          },
          "docs": "Returns all active List Groups for organisation"
        }
      ]
    }
  ],
  "bundled": true
}