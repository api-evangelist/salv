{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert custom-list-record API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "custom-list-record",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get batch records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.salv.com/api/v1/custom-lists/:customListId/records",
            "params": [
              {
                "name": "customListId",
                "value": "",
                "type": "path",
                "description": "ID of the custom list"
              }
            ]
          },
          "docs": "Get batch records"
        },
        {
          "info": {
            "name": "Create custom list record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.salv.com/api/v1/custom-lists/:customListId/records",
            "params": [
              {
                "name": "customListId",
                "value": "",
                "type": "path",
                "description": "ID of the custom list"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create custom list record"
        },
        {
          "info": {
            "name": "Get single Record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.salv.com/api/v1/custom-lists/:customListId/records/:id",
            "params": [
              {
                "name": "customListId",
                "value": "",
                "type": "path",
                "description": "ID of the custom list"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the record to be fetched"
              }
            ]
          },
          "docs": "Get single Record"
        },
        {
          "info": {
            "name": "Update custom list record",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{environment}.salv.com/api/v1/custom-lists/:customListId/records/:id",
            "params": [
              {
                "name": "customListId",
                "value": "",
                "type": "path",
                "description": "ID of the custom list"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the record to be updated"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update custom list record"
        },
        {
          "info": {
            "name": "Archive custom list record",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{environment}.salv.com/api/v1/custom-lists/:customListId/records/:id",
            "params": [
              {
                "name": "customListId",
                "value": "",
                "type": "path",
                "description": "ID of the custom list"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the record to be deleted"
              }
            ]
          },
          "docs": "Archive custom list record"
        }
      ]
    }
  ],
  "bundled": true
}