{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert screening-checks API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "screening-checks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Screen transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.salv.com/api/v1/transactions/:id/screening-checks",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "external ID of the transaction to screen"
              }
            ]
          },
          "docs": "Transaction is screened. Selection of screened attributes come from configuration."
        },
        {
          "info": {
            "name": "Screen person",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{environment}.salv.com/api/v1/persons/:id/screening-checks",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "external ID of the person to screen"
              }
            ]
          },
          "docs": "Person is screened. Selection of screened attributes come from configuration."
        }
      ]
    }
  ],
  "bundled": true
}