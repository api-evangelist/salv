{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salv AML alert API",
    "version": "1.0.9"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://app.salv.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "alert",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get transaction monitoring alert",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.salv.com/api/v1/alerts/:alertId",
            "params": [
              {
                "name": "alertId",
                "value": "",
                "type": "path",
                "description": "ID of alert to get"
              }
            ]
          },
          "docs": "Get transaction monitoring alert"
        }
      ]
    }
  ],
  "bundled": true
}