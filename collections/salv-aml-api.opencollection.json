        {
          "info": {
            "name": "Update person",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{environment}.salv.com/api/v2/persons/:personId",
            "params": [
              {
                "name": "personId",
                "value": "",
                "type": "path",
                "description": "External unique person ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Person update. Attributes in the request will be used to replace existing ones and type will be updated. \nAttributes supported maximum nesting depth is 2.\n\nIn case the operation is successful there will be an empty response.\n\n### Examples\n#### cURL\n```\n$ curl --request PUT \\\n  --url https://app.salv.com/api/v2/persons/{personId} \\\n  --header 'Authorization: Bearer {yourBearerToken}' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n    \"type\": \"LEGAL\",\n    \"attributes\": {\n      \"compan"
        },
        {
          "info": {
            "name": "Patch person",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{environment}.salv.com/api/v2/persons/:personId",
            "params": [
              {
                "name": "personId",
                "value": "",
                "type": "path",
                "description": "External unique person ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partial person update. Only attributes present in request will be added/updated. Attributes supported maximum\nnesting depth is 2.\n\nThis endpoint also supports optional person type update.\n\nIn case the operation is successful there will be an empty response.\n\n### Examples\n#### cURL\n```\n$ curl --request PATCH \\\n  --url https://app.salv.com/api/v2/persons/{personId} \\\n  --header 'Authorization: Bearer {yourBearerToken}' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\n    \"type\": \"LEGAL\""
        },
        {
          "info": {
            "name": "Fetch all persons",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.salv.com/api/v1/persons",
            "params": [
              {
                "name": "attribute",
                "value": "",
                "type": "query",
                "description": "Search query attribute"
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Person category"
              }
            ]
          },
          "docs": "NB! If there are more than 10000 results then the API shows the number of total results as 10000 and you can't paginate past the 10000th result."
        },
